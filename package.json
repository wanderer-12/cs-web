{
  "name": "web-fps",
  "version": "1.0.0",
  "description": "CSP — browser 3D FPS with Counter-Strike-like gunplay (single-player vs bots)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["fps", "three.js", "webgl", "game"],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.0",
  "type": "module",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
